# ==============================================================================
# YOURTUBE 2.0 - FRONTEND ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local and fill in your actual values.
# DO NOT commit .env.local file to version control!

# ==============================================================================
# BACKEND API CONFIGURATION
# ==============================================================================
# Backend API URL (must include /api suffix)
# Development: http://localhost:5000/api
# Production: https://your-backend-domain.com/api
BACKEND_URL=http://localhost:5000/api

# Public backend URL (visible to browser - must include /api suffix)
# This is exposed to the browser, so it must be the public URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000/api

# Alternative name for backend URL (will fall back to this if above not set)
# NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ==============================================================================
# FIREBASE CONFIGURATION (Optional - if using Firebase Auth/Storage)
# ==============================================================================
# Note: Firebase config is currently hardcoded in src/lib/firebase.js
# To make it configurable, you can modify the firebase.js file to use env vars
# NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
# NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ==============================================================================
# PRODUCTION NOTES
# ==============================================================================
# For production deployment on Vercel:
# 1. Update BACKEND_URL to your production backend domain
# 2. Update NEXT_PUBLIC_BACKEND_URL to your production backend domain
# 3. Ensure both include /api suffix
# 4. Add these values to Vercel project settings → Environment Variables
# 5. Never commit .env.local file to version control
# 6. Use Vercel's automatic environment variables if possible
